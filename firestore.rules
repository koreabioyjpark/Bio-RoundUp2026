// firestore.rules
// Firebase Console → Firestore → 규칙 탭에 붙여넣기

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. 신청자(학생) 데이터: 관리자 페이지에서 '완전 삭제' 시 
    // 학생의 신청 내역도 지워야 하므로 write 권한을 다시 열어줍니다.
    match /applicants/{userId} {
      allow read, write: if true;
    }

    // 2. 상담 슬롯(기업 부스) 데이터: 
    // 누구나 읽고 업데이트(승격/강등/취소)할 수 있게 하되, 
    // 문서 자체를 날려버리는(delete) 해킹만 방지합니다.
    match /slots/{slotId} {
      allow read, update: if true;
      allow create, delete: if false;
    }
  }
}